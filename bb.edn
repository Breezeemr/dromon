{:paths ["bb/src"]
 :tasks
 {setup
  {:doc "Starts the local integration environment (Postgres, Keto, Hydra) via Docker"
   :requires ([server.docker-env :as env])
   :task (if (every? env/container-running? ["ory-pg" "keto" "hydra"])
           (println "Integration environment already running -- skipping setup.")
           (env/start!))}

  teardown
  {:doc "Stops and removes the local integration environment"
   :requires ([server.docker-env :as env])
   :task (if (not-any? env/container-exists? ["ory-pg" "keto" "hydra"])
           (println "No integration containers found -- nothing to tear down.")
           (env/stop!))}

  tls-setup
  {:doc "Updates /etc/hosts to point fhir.local to 127.0.0.1 and generates a TLS dev certificate with mkcert."
   :task (let [domain    "fhir.local"
               keystore  (clojure.java.io/file "fhir-server/dev-keystore.p12")
               hosts-ok? (clojure.string/includes? (slurp "/etc/hosts") domain)]
           (if (and hosts-ok? (.exists keystore))
             (println "TLS already set up (hosts entry, dev-keystore.p12) -- skipping.")
             (do
               (if hosts-ok?
                 (println "Domain" domain "already in /etc/hosts.")
                 (do
                   (println "Adding" domain "to /etc/hosts (requires sudo)...")
                   (shell "sudo" "sh" "-c" (str "echo '127.0.0.1 " domain "' >> /etc/hosts"))))
               (if (.exists keystore)
                 (println "dev-keystore.p12 already exists, skipping mkcert.")
                 (do
                   (println "Generating dev certificate with mkcert...")
                   (shell "mkcert" "-install")
                   (shell "mkcert" "-pkcs12" "-p12-file" (.getPath keystore) domain))))))}

  inferno-setup
  {:doc "Clones the US Core Test Kit, installs custom suites (base-fhir-r4) and the bulk gem, patches docker-compose and builds the images. INFERNO_EXTRA_HOSTS adds host names the containers resolve to the host."
   :depends [tls-setup]
   :requires ([server.inferno-setup :as inferno-setup])
   :task (inferno-setup/us-core-setup! (System/getenv))}

  inferno-g10-setup
  {:doc "Clones the ONC (g)(10) certification kit at its pinned tag into inferno-g10-kit/ (separate from the US Core kit), patches docker-compose (root CA, host-gateway names, nginx on INFERNO_G10_PORT, default 8081) and builds the images. INFERNO_EXTRA_HOSTS adds host names the containers resolve to the host."
   :requires ([server.inferno-setup :as inferno-setup])
   :task (inferno-setup/g10-setup! (System/getenv))}

  inferno-g10-clients
  {:doc "Registers the Hydra clients the (g)(10) suite needs (public PKCE, confidential symmetric, EHR launch, confidential asymmetric, backend services) through INFERNO_HYDRA_ADMIN_URL, writes their credentials to a gitignored file and renders the g10 preset from inferno-custom/g10-presets. Never prints a secret."
   :requires ([server.inferno-g10-clients :as g10-clients])
   :task (g10-clients/-main (System/getenv))}

  inferno-g10
  {:doc "Runs the non-interactive (g)(10) groups headless (default: groups 1 and 3, whose SMART discovery subgroups 1.8 and 3.7 complete before the launch waits for a browser; INFERNO_AUTH_MODE=backend_services with INFERNO_GROUPS=8 for the Multi-Patient API) against an already running server. Defaults INFERNO_KIT=g10 INFERNO_TARGET=external; needs INFERNO_FHIR_URL. See docs/inferno-g10.md."
   :requires ([server.inferno-runner :as runner])
   :task (runner/run-with-defaults! {"INFERNO_KIT" "g10" "INFERNO_TARGET" "external"})}

  inferno-runner-test
  {:doc "Unit tests for the Inferno runner configuration, the kit compose patch and the g10 client registration payloads. Needs no containers."
   :requires ([babashka.classpath :as cp] [clojure.test :as test])
   :task (do (cp/add-classpath "bb/test")
             (require 'server.inferno-runner-test)
             (let [{:keys [fail error]} (test/run-tests 'server.inferno-runner-test)]
               (System/exit (if (pos? (+ fail error)) 1 0))))}

  inferno-run
  {:doc "Runs the Inferno Test Kit suite locally"
   :depends [inferno-setup]
   :task (shell {:dir "inferno-test-kit"} "./run.sh")}

  inferno-check
  {:doc "Smoke-test: checks that Inferno containers are healthy and the FHIR server responds to /metadata. Fast (~5s), no full test run."
   :depends [setup inferno-setup]
   :requires ([server.inferno-runner :as runner])
   :task (runner/check!)}

  inferno-test
  {:doc "Runs the Inferno CLI executor dynamically using Babashka."
   :depends [generate-uscore setup inferno-setup]
   :requires ([server.inferno-runner :as runner])
   :task (runner/run-check!)}

  smart-grant
  {:doc "Grants a subject SMART access to a set of patients: creates a Hydra app client (unless --subject) and records Keto tuples via the running server's /auth/grants API. Args: [--subject <id>] --patients p1,p2 [--realm <realm>] [--relations read,write] [--revoke | --list]"
   :requires ([server.smart-grant :as smart-grant])
   :task (apply smart-grant/-main *command-line-args*)}

  keto-realm-backfill
  {:doc "Backfills the fhir Keto namespace from realm-blind objects to realm-scoped ones. DRY RUN unless --apply. Args: [--realm <realm>] [--apply] [--prune]. See docs/keto-realm-scoping.md."
   :requires ([server.keto-realm-backfill :as backfill])
   :task (apply backfill/-main *command-line-args*)}

  keto-realm-backfill-test
  {:doc "Unit tests for the realm backfill planner. Needs no running Keto."
   :requires ([babashka.classpath :as cp] [clojure.test :as test])
   :task (do (cp/add-classpath "bb/test")
             (require 'server.keto-realm-backfill-test)
             (let [{:keys [fail error]} (test/run-tests 'server.keto-realm-backfill-test)]
               (System/exit (if (pos? (+ fail error)) 1 0))))}

  check-domains
  {:doc "Fails when a tracked file names a production domain, a consuming host's development hostnames, or a consuming host's own systems not listed in bb/check-domains-baseline.edn, and when a baseline entry matches nothing. --prune first removes the entries that match nothing."
   :requires ([server.check-domains :as cd])
   :task (System/exit (apply cd/-main *command-line-args*))}

  check-domains-test
  {:doc "Unit tests for check-domains, run against throwaway git repositories."
   :requires ([babashka.classpath :as cp] [clojure.test :as test])
   :task (do (cp/add-classpath "bb/test")
             (require 'server.check-domains-test)
             (let [{:keys [fail error]} (test/run-tests 'server.check-domains-test)]
               (System/exit (if (pos? (+ fail error)) 1 0))))}

  generate-uscore
  {:doc "Generates Malli schema packages (r4b, xver, fhir-extensions, sdc, uscore8) from FHIR StructureDefinitions. Pass --force to regenerate when output already exists."
   :task (let [force?     (some #{"--force"} *command-line-args*)
               output-dir (clojure.java.io/file "fhir/malli/uscore8/src")]
           (if (and (.exists output-dir) (not force?))
             (println "fhir/malli/uscore8/src already exists -- skipping. Pass --force to regenerate.")
             (do
               (println "Ensuring target/staging/src exists...")
               (.mkdirs (clojure.java.io/file "fhir-defintions-to-malli/target/staging/src"))
               (println "Generating Malli schemas (this can take a few minutes)...")
               (shell {:dir "fhir-defintions-to-malli"}
                      "clj" "-X" "com.breezeehr.main/generate-uscore!"))))}

  inferno-down
  {:doc "Stops the Inferno docker instances of both kits"
   :task (doseq [kit ["inferno-test-kit" "inferno-g10-kit"]]
           (if (.exists (clojure.java.io/file kit "docker-compose.yml"))
             (shell {:dir kit} "docker" "compose" "down")
             (println kit "not present -- nothing to stop.")))}

  trace
  {:doc "Wraps curl with X-Dromon-Trace: 1 and renders the captured span tree on stderr. Body passes through to stdout."
   :requires ([server.trace-cli :as tc])
   :task (apply tc/-main *command-line-args*)}

  compartment-e2e
  {:doc "Full-stack patient-compartment integration test against the real local Ory stack (Hydra token hook + Keto). Runs every scenario against the test-server on XTDB2 (or the test-server stores named as args, e.g. `bb compartment-e2e mock`). Skips if Docker is unavailable."
   :requires ([server.compartment-e2e-runner :as e2e])
   :task (apply e2e/run! *command-line-args*)}

  auth-stack-up
  {:doc "Starts the secondary auth stack for the interactive authorization_code flow: the main pool (ory-pg/keto/hydra) plus Kratos, all three Ory services over TLS on localhost (https://localhost:4444, :4433, :4466; the pair is minted with mkcert into docker/tls). Hydra's login/consent URLs point at the login/consent app on the host (https://localhost:3001). TOKEN_HOOK_URL enables the token hook. Never part of setup/inferno-test."
   :requires ([server.docker-env :as env])
   :task (env/start-auth-stack!
           (cond-> {}
             (System/getenv "TOKEN_HOOK_URL")
             (assoc :token-hook-url (System/getenv "TOKEN_HOOK_URL"))))}

  auth-stack-down
  {:doc "Removes the Kratos container and restores Hydra and Keto to their plain docker/*.yml configuration. The main pool keeps running."
   :requires ([server.docker-env :as env])
   :task (env/stop-auth-stack!)}}}
