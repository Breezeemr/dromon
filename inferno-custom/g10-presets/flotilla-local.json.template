{
  "title": "flotilla + login-consent + Hydra (local)",
  "id": "flotilla-local",
  "test_suite_id": "g10_certification",
  "inputs": [
    {"name": "url", "_type": "text", "value": "${FHIR_URL}"},
    {"name": "standalone_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "symmetric", "client_id": "${SYMMETRIC_CLIENT_ID}", "client_secret": "${SYMMETRIC_CLIENT_SECRET}"}},
    {"name": "expected_resources", "_type": "text", "value": "patient, condition, observation"},
    {"name": "ehr_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "symmetric", "client_id": "${EHR_CLIENT_ID}", "client_secret": "${EHR_CLIENT_SECRET}"}},
    {"name": "additional_patient_ids", "_type": "text", "value": ""},
    {"name": "bulk_server_url", "_type": "text", "value": "${FHIR_URL}"},
    {"name": "bulk_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "backend_services", "use_discovery": "false", "token_url": "${TOKEN_URL}",
               "client_id": "${BACKEND_CLIENT_ID}", "requested_scopes": "system/*.read",
               "encryption_algorithm": "${BACKEND_ALG}", "kid": "${BACKEND_KID}"}},
    {"name": "group_id", "_type": "text", "value": "${GROUP_ID}"},
    {"name": "bulk_patient_ids_in_group", "_type": "text", "value": "${PATIENT_IDS}"},
    {"name": "bulk_timeout", "_type": "text", "value": "180"},
    {"name": "public_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "public", "client_id": "${PUBLIC_CLIENT_ID}"}},
    {"name": "ehr_patient_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "symmetric", "client_id": "${EHR_CLIENT_ID}", "client_secret": "${EHR_CLIENT_SECRET}"}},
    {"name": "asymmetric_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "asymmetric", "client_id": "${ASYMMETRIC_CLIENT_ID}", "encryption_algorithm": "${ASYMMETRIC_ALG}"}},
    {"name": "v1_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "symmetric", "client_id": "${SYMMETRIC_CLIENT_ID}", "client_secret": "${SYMMETRIC_CLIENT_SECRET}"}},
    {"name": "granular_scopes_1_auth_info", "_type": "auth_info",
     "value": {"auth_type": "symmetric", "client_id": "${SYMMETRIC_CLIENT_ID}", "client_secret": "${SYMMETRIC_CLIENT_SECRET}"}},
    {"name": "granular_scopes_2_auth_info", "_type": "auth_info",
     "value": {"auth_type": "symmetric", "client_id": "${SYMMETRIC_CLIENT_ID}", "client_secret": "${SYMMETRIC_CLIENT_SECRET}"}},
    {"name": "granular_scopes_selection_smart_auth_info", "_type": "auth_info",
     "value": {"auth_type": "symmetric", "client_id": "${SYMMETRIC_CLIENT_ID}", "client_secret": "${SYMMETRIC_CLIENT_SECRET}"}}
  ]
}
