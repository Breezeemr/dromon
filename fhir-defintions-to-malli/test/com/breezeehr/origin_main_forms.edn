 "root/SheetD"
 (->
  (base-Sheet)
  (m/schema options)
  m/deref
  (mu/update-properties merge {:closed true, :resourceType "SheetD"})
  (mu/update
   :entry
   (fn
    [sch]
    (let
     [inner (mu/get sch 0)]
     [:sequential
      (let
       [inner
        (-> inner (m/schema options) m/deref)
        multi
        (if
         (clojure.core/= :multi (m/type inner))
         inner
         (m/schema
          [:multi {:closed false} [:malli.core/default inner]]
          options))
        props
        (or (m/properties multi) {})
        kids
        (vec (m/children multi))
        base-arm
        (or
         (some
          (fn
           [c]
           (when
            (clojure.core/=
             "http://t.example/StructureDefinition/SecAN"
             (first c))
            (nth c 2)))
          kids)
         (some
          (fn
           [c]
           (when
            (clojure.core/= :malli.core/default (first c))
            (nth c 2)))
          kids)
         [:map {:closed false}])
        arm
        (->
         base-arm
         (mu/assoc
          :act
          [:ref :example.t.StructureDefinition.SecAN/v1-0]))
        idx
        (first
         (keep-indexed
          (fn
           [i c]
           (when
            (clojure.core/=
             "http://t.example/StructureDefinition/SecAN"
             (first c))
            i))
          kids))
        kids'
        (if
         idx
         (assoc
          kids
          idx
          ["http://t.example/StructureDefinition/SecAN" arm])
         (conj
          kids
          ["http://t.example/StructureDefinition/SecAN" arm]))]
       (m/schema (into [:multi props] kids') options))])))
  (mu/update
   :entry
   (fn
    [sch]
    (let
     [inner (mu/get sch 0)]
     [:sequential
      (let
       [inner
        (-> inner (m/schema options) m/deref)
        multi
        (if
