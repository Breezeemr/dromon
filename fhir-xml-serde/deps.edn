{:paths ["src"]
 :deps  {org.clojure/clojure           {:mvn/version "1.12.4"}
         metosin/malli                 {:mvn/version "0.20.1"}
         com.breezeehr/fhir-primitives {:local/root "../fhir-primitives"}}
 :aliases
 {:test {:extra-paths ["test" "dev-resources"]
         :extra-deps  {lambdaisland/kaocha           {:mvn/version "1.91.1392"}
                       org.clojure/test.check        {:mvn/version "1.1.1"}
                       com.breezeehr/fhir-malli-r4b  {:local/root "../fhir/malli/r4b"}}
         :main-opts   ["-m" "kaocha.runner"]}
  :gate {:extra-paths ["dev" "test"]
         :extra-deps  {com.breezeehr/fhir-malli-r4b {:local/root "../fhir/malli/r4b"}}
         :jvm-opts    ["-Xmx4g"]
         :main-opts   ["-m" "gate"]}
  :xsd   {:extra-paths ["dev" "test"]
          :extra-deps  {com.breezeehr/fhir-malli-r4b {:local/root "../fhir/malli/r4b"}}
          :jvm-opts    ["-Xmx4g"]
          :main-opts   ["-m" "xsd-check"]}
  :check {:extra-paths ["dev" "test" "dev-resources"]
          :extra-deps  {com.breezeehr/fhir-malli-r4b {:local/root "../fhir/malli/r4b"}}
          :jvm-opts    ["-Xmx4g"]}}}
