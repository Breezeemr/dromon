{:paths ["src"]
 :deps {fhir-store/server {:local/root "../fhir-server"}
        fhir-terminology/fhir-terminology {:local/root "../fhir-terminology"}
        integrant/integrant {:mvn/version "0.13.1"}
        metosin/malli {:mvn/version "0.20.1"}}
 :aliases
 {;; --- OpenTelemetry (opt-in via -M:otel) ---
  ;; Pulls the OTel SDK + OTLP exporter onto the classpath so Telemere's
  ;; open-telemetry handler can boot. Default classpath stays lean.
  :otel {:extra-deps {io.opentelemetry/opentelemetry-sdk                        {:mvn/version "1.43.0"}
                      io.opentelemetry/opentelemetry-exporter-otlp              {:mvn/version "1.43.0"}
                      io.opentelemetry/opentelemetry-sdk-extension-autoconfigure {:mvn/version "1.43.0"}}}

  ;; --- FHIR store backends ---
  :store/xtdb2 {:extra-deps {fhir-store/xtdb2 {:local/root "../fhir-store-xtdb2"}}}
  :store/mock  {:extra-deps {fhir-store/mock  {:local/root "../fhir-store-mock"}}}
  ;; fhir-store-datomic lives outside the dromon tree (sibling of dromon/).
  :store/datomic {:extra-deps {fhir-store/datomic {:local/root "../../fhir-store-datomic"}}}

  ;; --- FHIR malli schema packages ---
  :malli/r4b             {:extra-deps {com.breezeehr/fhir-malli-r4b             {:local/root "../fhir/malli/r4b"}}}
  :malli/xver            {:extra-deps {com.breezeehr/fhir-malli-xver            {:local/root "../fhir/malli/xver"}}}
  :malli/fhir-extensions {:extra-deps {com.breezeehr/fhir-malli-fhir-extensions {:local/root "../fhir/malli/fhir-extensions"}}}
  :malli/sdc             {:extra-deps {com.breezeehr/fhir-malli-sdc             {:local/root "../fhir/malli/sdc"}}}
  :malli/uscore8         {:extra-deps {com.breezeehr/fhir-malli-uscore8         {:local/root "../fhir/malli/uscore8"}}}
  ;; Breeze IG capabilities + storage overlays (HumanName/Address USEP).
  ;; Lives outside the dromon tree (sibling of dromon/).
  :malli/breeze          {:extra-deps {com.breezeehr/fhir-malli-breeze          {:local/root "../../fhir-igs/breeze-ig/malli/breeze"}
                                       com.breezeehr/fhir-malli-uscore8         {:local/root "../../fhir-igs/uscore8"}
                                       com.breezeehr/fhir-malli-r4b             {:local/root "../../fhir-igs/r4b"}}}

  :dev {:extra-paths ["dev" "../fhir-server/dev"]}
  :test {:extra-paths ["test" "../fhir-server/test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                      fhir-store/mock        {:local/root "../fhir-store-mock"}
                      fhir-store/xtdb2       {:local/root "../fhir-store-xtdb2"}
                      com.breezeehr/fhir-malli-r4b     {:local/root "../fhir/malli/r4b"}
                      com.breezeehr/fhir-malli-uscore8 {:local/root "../fhir/malli/uscore8"}
                      ;; Pinned top-level so top-dep-wins resolves the
                      ;; otherwise-ambiguous transitive locals: the
                      ;; fhir-malli-breeze package references the fhir-igs
                      ;; copies of these libs while uscore8 references the
                      ;; dromon-local ones, which fails classpath
                      ;; resolution on a cold cache ("no known ancestor
                      ;; relationship between local versions").
                      com.breezeehr/fhir-malli-xver    {:local/root "../fhir/malli/xver"}
                      com.breezeehr/fhir-malli-fhir-extensions {:local/root "../fhir/malli/fhir-extensions"}
                      com.breezeehr/fhir-malli-sdc     {:local/root "../fhir/malli/sdc"}
                      com.breezeehr/fhir-malli-breeze  {:local/root "../../fhir-igs/breeze-ig/malli/breeze"}}
         :main-opts ["-m" "kaocha.runner"]
         :jvm-opts ["-Xmx6g"
                    "--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED"]}}}
