{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        com.xtdb/xtdb-core {:mvn/version "2.2.0-beta3"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1093"}
        com.zaxxer/HikariCP {:mvn/version "6.2.1"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        com.taoensso/telemere {:mvn/version "1.2.1"}
        fhir-store/protocol {:local/root "../fhir-store-protocol"}
        com.breezeehr/fhir-primitives {:local/root "../fhir-primitives"}
        metosin/malli {:mvn/version "0.20.2"}
        integrant/integrant {:mvn/version "0.13.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]
         :jvm-opts ["-Xmx6g"
                    "--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED"
                    ;; JEP 498 (Java 24+): Arrow's netty allocator needs Unsafe
                    ;; memory access; without this the node init dies in
                    ;; DefaultAllocationManagerFactory.<clinit>.
                    "--sun-misc-unsafe-memory-access=allow"
                    ;; XTDB 2.2.0-beta3 asks for this on JDK 25+: Netty disables
                    ;; sun.misc.Unsafe there unless told otherwise. Today Netty
                    ;; also infers it from the flag above; this keeps it explicit.
                    "-Dio.netty.noUnsafe=false"]}}}
